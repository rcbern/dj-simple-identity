# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://auth:auth@localhost:5432/auth

# Redis (Streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT RS256 keys (paths to PEM files)
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_PUBLIC_KEY_PATH=certs/public.pem

# MFA (Fernet symmetric key)
MFA_ENCRYPTION_KEY=

# Token policy
ALLOW_MULTI_DEVICE_REFRESH_TOKENS=False

# Logging
LOG_LEVEL=INFO

# SSO - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=